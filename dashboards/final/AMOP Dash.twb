      <column caption='Amd Close' datatype='real' name='[AMD_CLOSE]' role='measure' type='quantitative' />
      <column caption='Avgo Close' datatype='real' name='[AVGO_CLOSE]' role='measure' type='quantitative' />
      <column caption='Ideal Portfolio Returns' datatype='real' name='[Calculation_1958784398888087552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(18000.99 * [Portfolio_Growth (%)]/100) + 18000.99' />
      </column>
      <column caption='Unrealised Potential' datatype='real' name='[Calculation_1958784398904111105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date] = DATE(&quot;2025-06-30&quot;) THEN&#13;&#10;    ROUND([Calculation_1958784398888087552] - [Savings], 2)&#13;&#10;END' />
      </column>
      <column caption='Location Preference' datatype='string' name='[Calculation_232779841131614208]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF [Customer_Name] = &quot;Customer A&quot; THEN &quot;US&quot;&#13;&#10;ELSEIF [Customer_Name] = &quot;Customer B&quot; THEN &quot;UK&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Latest Savings' datatype='real' name='[Calculation_232779841133547521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date] = { FIXED [Customer_Name]: MAX([Date]) } THEN [Savings]&#13;&#10;END' />
      </column>
      <column caption='Percentage Returns' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_232779841156349954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date] = { FIXED [Customer_Name]: MAX([Date]) } THEN [Percentage_Growth]&#13;&#10;END' />
      </column>
      <column caption='Latest Energy Inlfation %' datatype='real' name='[Calculation_232779841164566533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Date (US_inflation_index.csv)] = {MAX([Date (US_inflation_index.csv)])} THEN [Energy_Growth_%]&#13;&#10;END' />
